# Copy this file to .env and fill in real values for production.
# Never commit .env to version control.

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# HMAC secret for supplier login endpoint
PROVEEDOR_SECRET_KEY=replace-with-a-strong-random-value

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames in production
# Example: DJANGO_ALLOWED_HOSTS=api.bocar.com,www.bocar.com
DJANGO_ALLOWED_HOSTS=
